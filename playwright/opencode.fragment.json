{
  "mcp": { "servers": {
    "playwright-test": { "type": "local",
      "command": ["run-limited", "3G", "npx", "playwright", "run-test-mcp-server"] },
    "playwright": { "type": "local",
      "command": ["run-limited", "2G", "npx", "playwright", "mcp", "--browser", "chromium",
        "--headless", "--isolated",
        "--proxy-server", "http://127.0.0.1:9",
        "--proxy-bypass", "127.0.0.1,localhost,.localhost",
        "--allowed-origins", "http://127.0.0.1:3000;http://localhost:3000",
        "--output-dir", "test-results/mcp"] }
  } },
  "agents": {
    "playwright-test-planner":   { "permissions": [ { "action": "edit", "resource": "*", "effect": "deny" } ] },
    "playwright-test-generator": { "permissions": [ { "action": "edit", "resource": "*", "effect": "deny" } ] }
  }
}
